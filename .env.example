# ─────────────────────────────────────────────────────────────────────────────
# Gmail Contact Form Environment Configuration (Example Template)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT:
# 1. Do NOT put your actual credentials or App Password into this file.
# 2. Copy these variables to .env.local for local testing.
# 3. Add these variables to your Vercel Project Settings for production.
# ─────────────────────────────────────────────────────────────────────────────

# Authenticated Gmail address used as the sender
GMAIL_USER=your-email@gmail.com

# Gmail 16-character App Password (generate at: https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your-app-password

# Recipient inbox where contact inquiries should be delivered
CONTACT_EMAIL=your-email@gmail.com
